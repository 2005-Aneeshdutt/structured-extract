# Copy to `.env` and fill in. `.env` is gitignored.
#
# Every account-specific identifier in this repo reads from here, so forking it
# means editing ONE file rather than hunting hardcoded usernames through five
# modules. Defaults that point at an account you do not own will 404 loudly
# rather than fail silently.

# --- credentials -----------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# https://huggingface.co/settings/tokens  (needs write scope to push)
HF_TOKEN=

# https://wandb.ai/authorize   (optional; training logs to stdout without it)
WANDB_API_KEY=

# --- your namespaces -------------------------------------------------------
GITHUB_USER=2005-Aneeshdutt
HF_USER=

# --- derived repo names (usually leave as-is) ------------------------------
STRUCTURED_EXTRACT_REPO=https://github.com/2005-Aneeshdutt/structured-extract
HF_DATASET_REPO=${HF_USER}/structured-extract-jobs
HF_ADAPTER_REPO=${HF_USER}/qwen2.5-1.5b-jobs-extract
HF_GGUF_REPO=${HF_USER}/qwen2.5-1.5b-jobs-extract-GGUF
HF_SPACE=${HF_USER}/structured-extract-demo

# --- teacher budget --------------------------------------------------------
# Check YOUR actual limits at https://aistudio.google.com/ -- free-tier quotas
# change and differ per model. These are the values the Makefile assumes.
TEACHER_MODEL_GOLD=gemini-2.0-flash
TEACHER_MODEL_BULK=gemini-2.0-flash-lite
REQUESTS_PER_DAY=1500
REQUESTS_PER_MINUTE=15
