# Copy to `.env` and fill in. `.env` is gitignored.
#
# Every account-specific identifier in this repo reads from here, so forking it
# means editing ONE file rather than hunting hardcoded usernames through five
# modules. Defaults that point at an account you do not own will 404 loudly
# rather than fail silently.

# --- credentials -----------------------------------------------------------
# You need ONE teacher key. Gemini is the default and has the larger free tier.
#
# Free key: https://aistudio.google.com/apikey        (1500 req/day, 15 req/min)
GOOGLE_API_KEY=

# Alternative teacher: --teacher openrouter. One key, many models.
# https://openrouter.ai/settings/keys                 (starts 'sk-or-v1-')
# NOTE: the free-model allowance is a per-ACCOUNT daily cap and is much smaller
# than Gemini's unless you have purchased credit. Confirm yours before planning a
# multi-day run: https://openrouter.ai/docs/api-reference/limits
OPENROUTER_API_KEY=

# https://huggingface.co/settings/tokens  (needs write scope to push)
HF_TOKEN=

# https://wandb.ai/authorize   (optional; training logs to stdout without it)
WANDB_API_KEY=

# --- your namespaces -------------------------------------------------------
GITHUB_USER=2005-Aneeshdutt
HF_USER=

# --- derived repo names (usually leave as-is) ------------------------------
STRUCTURED_EXTRACT_REPO=https://github.com/2005-Aneeshdutt/structured-extract
HF_DATASET_REPO=${HF_USER}/structured-extract-jobs
HF_ADAPTER_REPO=${HF_USER}/qwen2.5-1.5b-jobs-extract
HF_GGUF_REPO=${HF_USER}/qwen2.5-1.5b-jobs-extract-GGUF
HF_SPACE=${HF_USER}/structured-extract-demo

# --- teacher budget --------------------------------------------------------
# Ceiling for whichever teacher is selected. Precedence:
#     command-line flag  >  this file  >  built-in per-teacher default.
# Set these to YOUR account's real limits; quotas change and differ per model.
#     Google AI Studio free   : 1500 / 15
#     OpenRouter, paid model  : no daily cap -- 8000 / 60
#     OpenRouter, :free model : per-ACCOUNT cap, credit-gated, often ~50/day
#                               https://openrouter.ai/docs/api-reference/limits
# Blank means "use the built-in default for the selected teacher".
REQUESTS_PER_DAY=
REQUESTS_PER_MINUTE=
